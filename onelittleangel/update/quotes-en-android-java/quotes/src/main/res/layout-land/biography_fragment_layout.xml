<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              xmlns:card="http://schemas.android.com/apk/res-auto"
              android:id="@+id/ll_biography"
              android:orientation="vertical"
              android:layout_width="match_parent"
              android:layout_height="wrap_content">

    <android.support.v7.widget.CardView
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:card="http://schemas.android.com/apk/res-auto"
        android:id="@+id/cv_presentation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/content_card_margin"
        android:layout_marginStart="@dimen/content_card_margin"
        android:layout_marginTop="@dimen/activity_horizontal_margin"
        android:layout_marginRight="@dimen/content_card_margin"
        android:layout_marginEnd="@dimen/content_card_margin"
        android:layout_marginBottom="@dimen/activity_horizontal_margin"
        card:cardCornerRadius="2.0dip"
        card:cardElevation="@dimen/card_elevation"
        card:cardBackgroundColor="@android:color/white">

        <LinearLayout
            android:id="@+id/ll_presentation"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/activity_horizontal_margin">

          <!--  <ContentTextViewNativeBiographyaphy-->
                <!--android:id="@+id/txtn_presentation_title"-->
                <!--android:layout_width="match_parent"-->
                <!--android:layout_height="wrap_content"-->
                <!--android:layout_margin="@dimen/activity_horizontal_margin"-->
                <!--android:text="@string/app_name"-->
                <!--android:gravity="center_horizontal"-->
                <!--android:textSize="22sp"-->
                <!--android:layout_gravity="center_horizontal"-->
                <!--android:textColor="@android:color/black"/>-->
        </LinearLayout>
    </android.support.v7.widget.CardView>

    <com.sc.en.quotes.layers.mvp.biography.listgridviews.CardGridView
        xmlns:grid="http://schemas.android.com/apk/res-auto"
        android:id="@+id/gv_carrousel"
        android:layout_width="match_parent"
        android:layout_height="700dp"
        android:layout_marginEnd="@dimen/action_bar_padding_viewstub"
        android:layout_marginLeft="@dimen/action_bar_padding_viewstub"
        android:layout_marginRight="@dimen/action_bar_padding_viewstub"
        android:layout_marginStart="@dimen/action_bar_padding_viewstub"
        android:layout_marginTop="@dimen/activity_horizontal_margin"
        android:layout_marginBottom="@dimen/activity_horizontal_margin"
        android:columnWidth="140dp"
        android:gravity="center"
        android:numColumns="auto_fit"
        android:overScrollMode="never"
        android:scrollbars="none"
        android:stretchMode="columnWidth"
        grid:list_card_layout_resourceID="@layout/gridviewlist_carrousel"/>
</LinearLayout>