<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card="http://schemas.android.com/apk/res-auto"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_centerVertical="true"
    android:paddingTop="@dimen/activity_horizontal_margin"
    android:paddingBottom="@dimen/activity_horizontal_margin"
    android:orientation="vertical"
    android:overScrollMode="never"
    android:gravity="center_horizontal"
    >
    <android.support.v7.widget.RecyclerView
        android:id="@+id/mails_dialog_list_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_margin="@dimen/activity_horizontal_margin"
        android:overScrollMode="never" />

    <android.support.v7.widget.RecyclerView
        android:id="@+id/mails_added_dialog_list_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_margin="@dimen/activity_horizontal_margin"
        android:overScrollMode="never" />

    <android.support.design.widget.TextInputEditText
        android:id="@+id/et_mail_comment"
        android:inputType="textMultiLine"
        android:gravity="top"
        android:hint="@string/add_comment"
        android:lines="3"
        android:textSize="@dimen/tc_text_size"

        android:layout_height="wrap_content"
        android:layout_width="match_parent"
        android:theme="@style/CustomTheme"
        android:scrollbars="vertical"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_marginTop="20dp"
        android:layout_height="@dimen/mail_textinput_layout_height"
        android:orientation="horizontal">
    <android.support.design.widget.TextInputLayout
        android:id="@+id/input_layout_email"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"

        app:hintTextAppearance="@style/TextLabel"
        app:errorTextAppearance="@style/error_appearance">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

        <android.support.design.widget.TextInputEditText
            android:id="@+id/input_email"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:theme="@style/CustomTheme"
            android:inputType="textEmailAddress"
            android:textSize="@dimen/tc_text_size"
            android:hint="@string/hint_email" >
        </android.support.design.widget.TextInputEditText>

        <ImageView
            android:id="@+id/iv_add_email"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/activity_horizontal_margin"
            android:background="@drawable/ic_add_email"/>
        </LinearLayout>
    </android.support.design.widget.TextInputLayout>

    </LinearLayout>

    <android.support.v7.widget.CardView
        android:id="@+id/cv_action_on_form"
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        card:cardCornerRadius="2dp"
        card:cardElevation="@dimen/card_elevation"
        card:cardUseCompatPadding="true"
        card:cardBackgroundColor="@android:color/white"
        card:contentPadding="@dimen/activity_horizontal_margin">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <com.sc.fr.onelittleangel.layers.mvp.common.customs.textviews.TextViewNative
                android:id="@+id/send_mails"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:text="@string/send_mail"
                android:layout_marginLeft="@dimen/activity_horizontal_margin"
                android:layout_marginRight="@dimen/activity_horizontal_margin"
                android:textStyle="bold"
                android:textSize="@dimen/tc_text_size"
                />
        </LinearLayout>
    </android.support.v7.widget.CardView>
</LinearLayout>