<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:orientation="vertical"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_gravity="center_horizontal"
    >
    <com.sc.en.bouddhism.layers.mvp.common.customs.textviews.TextViewNative
        android:id="@+id/txt_go_to_typeface_settings"
        android:layout_width="wrap_content"
        android:layout_gravity="center_horizontal"
        android:gravity="center_horizontal"
        android:layout_height="wrap_content"
        android:text="@string/choose_typeface_ask"
        android:textSize="@dimen/tc_text_size"
        android:textColor="@android:color/black"/>

        <TextView
            android:id="@+id/go_to_typeface_settings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="@string/choose_typeface"
            android:textStyle="bold"
            android:textSize="@dimen/tc_text_size"
            android:layout_margin="@dimen/activity_horizontal_margin"/>
</LinearLayout>