<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_centerVertical="true"
    android:layout_gravity="center_horizontal"
    android:padding="@dimen/activity_horizontal_margin"
    >
    <com.sc.en.bouddhism.layers.mvp.common.customs.textviews.TextViewNative
        android:id="@+id/txt_accounts_ask"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/activity_horizontal_margin"
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:text="@string/adding_to_favorites_ask"
        android:textSize="@dimen/tc_text_size"
        android:textColor="@android:color/black"/>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal">
    <TextView
        android:id="@+id/confirm_go_to_account"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/confirm"

        android:textStyle="bold"
        android:textSize="@dimen/tc_text_size"
        android:layout_marginLeft="@dimen/activity_horizontal_margin"
        android:layout_marginRight="50dp"

        />
        <TextView
            android:id="@+id/cancel_go_to_account"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cancel"
            android:textStyle="bold"
            android:textSize="@dimen/tc_text_size"
            android:layout_marginLeft="50dp"
            android:layout_marginRight="@dimen/activity_horizontal_margin"
            />
    </LinearLayout>

</LinearLayout>