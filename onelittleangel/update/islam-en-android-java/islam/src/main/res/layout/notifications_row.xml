<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:id="@+id/fonts_dialog_row"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="vertical"
              android:focusableInTouchMode="false"
              android:paddingTop="@dimen/action_bar_margin"
              android:paddingBottom="@dimen/action_bar_margin">

    <com.sc.en.islam.layers.mvp.common.customs.textviews.TextViewNative
        android:id="@+id/notification_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="false"
        android:layout_gravity="center_vertical"
        android:text="@string/app_name"
        android:textColor="@android:color/black"
        android:textSize="@dimen/tc_text_size"/>

     <LinearLayout
         android:layout_width="wrap_content"
         android:layout_height="wrap_content"
         android:orientation="horizontal"
         android:layout_gravity="right|center_vertical">
     <com.sc.en.islam.layers.mvp.common.customs.textviews.TextViewNative
         android:id="@+id/txt_notification_time"
         android:layout_width="wrap_content"
         android:layout_height="wrap_content"
         android:textSize="@dimen/tc_text_size"
         android:clickable="true"
         android:textColor="@android:color/black"
         android:layout_marginRight="@dimen/activity_horizontal_margin"
         />

    <ImageView
        android:id="@+id/notification_cb"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:clickable="false"
        android:src="@drawable/ic_cb_fonts"/>
     </LinearLayout>
</FrameLayout>