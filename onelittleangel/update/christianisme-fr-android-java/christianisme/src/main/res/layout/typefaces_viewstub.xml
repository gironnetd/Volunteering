<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              xmlns:card="http://schemas.android.com/apk/res-auto"
              android:orientation="vertical"
              android:id="@+id/ll_type_faces_fragment"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:overScrollMode="never">
    <android.support.v7.widget.CardView
        android:id="@+id/typefaces_card_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never"
        android:layout_marginLeft="@dimen/content_card_margin"
        android:layout_marginStart="@dimen/content_card_margin"
        android:layout_marginRight="@dimen/content_card_margin"
        android:layout_marginEnd="@dimen/content_card_margin"
        android:layout_marginBottom="@dimen/activity_horizontal_margin"
        card:cardCornerRadius="2dp"
        card:cardElevation="@dimen/card_elevation"
        card:cardBackgroundColor="@android:color/white"
        card:contentPadding="@dimen/activity_horizontal_double_margin">
    <android.support.v7.widget.RecyclerView
        android:id="@+id/typefaces_dialog_list_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        android:scrollbars="none"/>
    </android.support.v7.widget.CardView>
</LinearLayout>