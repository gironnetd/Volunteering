<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal">

    <com.sc.fr.hindouisme.layers.mvp.common.customs.spinkits.SpinKitView
        android:id="@+id/spin_kit"
        style="@style/SpinKitView.Large"
        android:layout_width="@dimen/spin_kit_dimen"
        android:layout_height="@dimen/spin_kit_dimen"
        android:layout_margin="@dimen/activity_horizontal_margin"
        android:layout_gravity="center"
        android:fitsSystemWindows="true"
        android:indeterminate="true" />

    <com.sc.fr.hindouisme.layers.mvp.common.customs.textviews.TextViewNative
        android:id="@+id/txtn_waiting"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/activity_horizontal_margin"
        android:padding="@dimen/action_bar_margin"
        android:background="@drawable/test"
        android:layout_gravity="center_horizontal"
        android:layout_margin="@dimen/activity_horizontal_margin"
        android:text="@string/bibliography_loading"
        android:textSize="@dimen/tc_text_size"
        android:textColor="@color/colorAccent"/>

    <android.support.v7.widget.CardView
        xmlns:card="http://schemas.android.com/apk/res-auto"
        android:id="@+id/cv_biography_dialog"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/activity_horizontal_margin"
        android:orientation="vertical"
        card:cardBackgroundColor="@android:color/white"
        card:cardCornerRadius="2.0dip"
        card:cardElevation="@dimen/card_elevation"
        >

        <com.sc.fr.hindouisme.layers.mvp.common.customs.textviews.TextViewNative
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/activity_horizontal_margin"
            android:layout_centerHorizontal="true"
            android:layout_alignParentTop="true"
            android:layout_margin="@dimen/activity_horizontal_margin"
            android:text="@string/bibliography_loading"
            android:textSize="20sp"
            android:textColor="@color/colorAccent"/>
        </android.support.v7.widget.CardView>

</LinearLayout>