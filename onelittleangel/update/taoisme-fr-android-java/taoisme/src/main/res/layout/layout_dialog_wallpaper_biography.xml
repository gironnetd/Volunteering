<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_centerVertical="true"
    android:layout_gravity="fill_horizontal">

    <LinearLayout
        android:id="@+id/ll_home_screen"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:orientation="vertical"
        android:gravity="center_horizontal">
    <ImageView
        android:id="@+id/iv_home_screen"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/activity_horizontal_margin"
        android:background="@drawable/ic_home_screen"/>

    <TextView
        android:id="@+id/tv_home_screen"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="@dimen/wallpappers_text_size"
        android:text="Écran d'accueil"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_lock_screen"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:layout_centerHorizontal="true"
        android:orientation="vertical"
        android:gravity="center_horizontal">
    <ImageView
        android:id="@+id/iv_lock_screen"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/activity_horizontal_margin"
        android:background="@drawable/ic_lock_screen"/>

    <TextView
        android:id="@+id/tv_lock_screen"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="@dimen/wallpappers_text_size"
        android:text="Écran de\nverrouillage"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_home_lock_screen"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:layout_alignParentRight="true"
        android:orientation="vertical"
        android:gravity="center_horizontal">

    <ImageView
        android:id="@+id/iv_home_lock_screen"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/activity_horizontal_margin"
        android:background="@drawable/ic_home_lock_screen"/>

    <TextView
        android:id="@+id/tv_home_lock_screen"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="@dimen/wallpappers_text_size"
        android:text="Écran d'accueil et\n de verrouillage"/>
    </LinearLayout>
</RelativeLayout>