<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              xmlns:card="http://schemas.android.com/apk/res-auto"
              android:orientation="vertical"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:theme="@style/Theme.AppCompat">
    <android.support.v7.widget.CardView
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/cv_account_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center_vertical"
        android:layout_marginBottom="@dimen/activity_horizontal_margin"
        android:layout_marginLeft="@dimen/content_card_margin"
        android:layout_marginStart="@dimen/content_card_margin"
        android:layout_marginRight="@dimen/content_card_margin"
        android:layout_marginEnd="@dimen/content_card_margin"
        android:visibility="invisible"
        card:cardCornerRadius="2dp"
        card:cardElevation="@dimen/card_elevation"
        card:cardBackgroundColor="@android:color/white"
        card:contentPadding="@dimen/activity_horizontal_margin">

        <RelativeLayout

            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center">
        <com.sc.fr.confucianisme.layers.mvp.common.customs.textviews.TextViewNative
            android:id="@+id/social_network_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/tc_text_size"
            android:text="@string/twitter"
            android:textColor="@android:color/black"
            android:visibility="gone"
            android:layout_gravity="center_horizontal"/>

            <android.support.design.widget.TextInputLayout
                android:id="@+id/input_layout_email"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:hintTextAppearance="@style/TextLabel"
                app:errorTextAppearance="@style/error_appearance">

                <android.support.design.widget.TextInputEditText
                    android:id="@+id/input_email"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:theme="@style/CustomTheme"
                    android:textSize="@dimen/tc_text_size"
                    android:inputType="textEmailAddress"
                    android:hint="@string/hint_email" >
                </android.support.design.widget.TextInputEditText>
            </android.support.design.widget.TextInputLayout>

            <com.sc.fr.confucianisme.layers.mvp.common.customs.textviews.TextViewNative
                android:id="@+id/txt_label_identifier"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="identifiant : "
                android:layout_marginTop="@dimen/activity_horizontal_margin"
                android:textSize="@dimen/tc_text_size"
                android:textColor="@android:color/black"
                android:layout_centerHorizontal="true"
                android:layout_alignParentTop="true"/>

            <com.sc.fr.confucianisme.layers.mvp.common.customs.textviews.TextViewNative
                android:id="@+id/txt_identifer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/activity_horizontal_margin"
                android:layout_below="@id/txt_label_identifier"
                android:textSize="@dimen/tc_text_size"

                android:textColor="@android:color/black"
                android:layout_centerHorizontal="true"/>

            <android.support.v7.widget.CardView
                android:id="@+id/cv_action_on_form"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/activity_horizontal_margin"
                android:layout_centerInParent="true"
                card:cardCornerRadius="2dp"
                card:cardElevation="@dimen/card_elevation"
                card:cardUseCompatPadding="true"
                card:cardBackgroundColor="@android:color/white">

                <com.sc.fr.confucianisme.layers.mvp.common.customs.textviews.TextViewNative
                    android:id="@+id/connect_txtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/activity_horizontal_margin"
                    android:textSize="@dimen/tc_text_size"
                    android:textColor="@android:color/black"
                    android:text="@string/modify"/>
            </android.support.v7.widget.CardView>
        </RelativeLayout>
    </android.support.v7.widget.CardView>
</LinearLayout>