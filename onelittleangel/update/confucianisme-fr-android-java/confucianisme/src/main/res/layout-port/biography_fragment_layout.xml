<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              xmlns:card="http://schemas.android.com/apk/res-auto"
              android:id="@+id/ll_biography"
              android:orientation="vertical"
              android:layout_width="match_parent"
              android:layout_height="wrap_content">

    <android.support.v7.widget.CardView
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:card="http://schemas.android.com/apk/res-auto"
        android:id="@+id/cv_presentation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/content_card_margin"
        android:layout_marginStart="@dimen/content_card_margin"
        android:layout_marginTop="@dimen/activity_horizontal_margin"
        android:layout_marginRight="@dimen/content_card_margin"
        android:layout_marginEnd="@dimen/content_card_margin"
        android:layout_marginBottom="@dimen/activity_horizontal_margin"
        card:cardBackgroundColor="@android:color/white"
        card:cardCornerRadius="2.0dip"
        card:cardElevation="@dimen/card_elevation">

        <LinearLayout
            android:id="@+id/ll_presentation"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/activity_horizontal_margin">
        </LinearLayout>
    </android.support.v7.widget.CardView>

    <com.sc.fr.confucianisme.layers.mvp.biography.listgridviews.CardGridView
        xmlns:grid="http://schemas.android.com/apk/res-auto"
        android:id="@+id/gv_carrousel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/activity_horizontal_margin"
        android:layout_marginBottom="@dimen/activity_horizontal_margin"
        android:layout_marginStart="@dimen/activity_horizontal_margin"
        android:layout_marginLeft="@dimen/activity_horizontal_margin"
        android:layout_marginRight="@dimen/activity_horizontal_margin"
        android:layout_marginEnd="@dimen/activity_horizontal_margin"
        android:columnWidth="140dp"
        android:numColumns="auto_fit"
        android:stretchMode="columnWidth"
        android:gravity="center"
        android:scrollbars="none"
        android:overScrollMode="never"
        grid:list_card_layout_resourceID="@layout/gridviewlist_carrousel"/>

</LinearLayout>