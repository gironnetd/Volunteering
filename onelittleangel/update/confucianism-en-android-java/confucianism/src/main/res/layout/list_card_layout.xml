<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ll_card_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
<com.sc.en.confucianism.layers.mvp.common.customs.cardviews.CardViewNative
    android:id="@+id/mCardViewNative_list"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginLeft="@dimen/tc_fragment_padding"
    android:layout_marginStart="@dimen/tc_fragment_padding"
    android:layout_marginRight="@dimen/tc_fragment_padding"
    android:layout_marginEnd="@dimen/tc_fragment_padding"
    card:cardCornerRadius="2dp"
    card:cardElevation="@dimen/card_elevation"
    card:cardUseCompatPadding="true"
    card:cardBackgroundColor="@android:color/white"
    card:card_layout_resourceID="@layout/card_layout"
     />
</LinearLayout>