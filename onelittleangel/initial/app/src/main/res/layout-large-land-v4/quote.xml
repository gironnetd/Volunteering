<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@color/background"
    android:paddingLeft="0dp"
    android:paddingTop="0dp"
    android:paddingRight="0dp"
    android:paddingBottom="10dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:weightSum="10">
    <com.sc.fr.onelittleangel.bouddhisme.views.ActionBarCustom
        android:id="@+id/actionbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <RelativeLayout
        android:gravity="center"
        android:orientation="vertical"
        android:background="@drawable/background_listview_menu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="5dp"
        android:layout_marginRight="10dp"
        android:layout_marginBottom="5dp"
        android:layout_weight="10">
        <android.support.v4.view.ViewPager
            android:id="@+id/pager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </RelativeLayout>
    <com.sc.fr.onelittleangel.bouddhisme.views.MenuPortraitBarCustom
        android:id="@+id/menubarportrait"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"/>
    <com.sc.fr.onelittleangel.bouddhisme.views.MenuLandscapeBarCustom
        android:id="@+id/menubarlandscape"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"/>
    <RelativeLayout
        android:gravity="center"
        android:background="@drawable/table_background"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp">
        <ImageView
            android:id="@+id/back"
            android:tag="back"
            android:background="@drawable/back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="10dp"
            android:layout_centerVertical="true"
            android:contentDescription="@string/tools"/>
        <ImageView
            android:id="@+id/help"
            android:tag="help"
            android:background="@drawable/help"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toRightOf="@+id/back"
            android:layout_centerVertical="true"
            android:contentDescription="@string/tools"/>
        <ImageView
            android:id="@+id/textsizeless"
            android:tag="less"
            android:background="@drawable/zoomless"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="5dp"
            android:layout_toRightOf="@+id/help"
            android:layout_centerVertical="true"
            android:contentDescription="@string/tools"/>
        <ImageView
            android:gravity="center"
            android:id="@+id/textsizemore"
            android:tag="more"
            android:background="@drawable/zoommore"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:layout_toRightOf="@+id/textsizeless"
            android:layout_centerVertical="true"
            android:contentDescription="@string/tools"/>
        <ImageView
            android:gravity="center"
            android:id="@+id/textfont"
            android:tag="textfont"
            android:background="@drawable/textfont"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="10dp"
            android:layout_toRightOf="@+id/textsizemore"
            android:contentDescription="@string/tools"/>
        <ImageView
            android:id="@+id/button_back"
            android:tag="button_back"
            android:background="@drawable/ic_menu_back_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/back"
            android:layout_toRightOf="@+id/textfont"
            android:layout_centerVertical="true"
            android:contentDescription="@string/back"/>
        <ImageView
            android:id="@+id/button_forward"
            android:tag="button_forward"
            android:background="@drawable/ic_menu_forward_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/forward"
            android:layout_toRightOf="@+id/button_back"
            android:layout_centerVertical="true"
            android:contentDescription="@string/forward"/>
        <ImageView
            android:id="@+id/button_back_landscape"
            android:tag="button_back_landscape"
            android:background="@drawable/ic_menu_back_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/back"
            android:layout_toLeftOf="@+id/center"
            android:layout_centerVertical="true"
            android:contentDescription="@string/back"/>
        <TextView
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"/>
        <ImageView
            android:id="@+id/button_forward_landscape"
            android:tag="button_forward_landscape"
            android:background="@drawable/ic_menu_forward_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/forward"
            android:layout_toRightOf="@+id/center"
            android:layout_centerVertical="true"
            android:contentDescription="@string/forward"/>
        <EditText
            android:textSize="28sp"
            android:textColor="@android:color/black"
            android:id="@+id/edit"
            android:layout_width="70dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:maxLength="3"
            android:layout_toLeftOf="@+id/on"
            android:inputType="numberDecimal"/>
        <TextView
            android:textSize="28sp"
            android:textColor="@android:color/black"
            android:id="@+id/on"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_toLeftOf="@+id/go"
            android:layout_alignBaseline="@+id/number"/>
        <ImageView
            android:id="@+id/go"
            android:tag="go"
            android:background="@drawable/go"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="2dp"
            android:text="@string/forward"
            android:layout_toLeftOf="@+id/number"
            android:layout_centerVertical="true"
            android:contentDescription="@string/forward"/>
        <TextView
            android:textSize="28sp"
            android:textColor="@android:color/black"
            android:id="@+id/number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="5dp"
            android:layout_alignParentRight="true"/>
    </RelativeLayout>
</LinearLayout>
