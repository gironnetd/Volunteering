<?xml version="1.0" encoding="utf-8"?>
<com.sc.fr.onelittleangel.bouddhisme.views.CheckableRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:paddingLeft="5dp"
    android:paddingTop="5dp"
    android:paddingRight="5dp"
    android:paddingBottom="5dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginRight="10dp">
    <com.sc.fr.onelittleangel.bouddhisme.views.InertCheckBox
        android:id="@+id/singleitemCheckBox"
        android:paddingRight="20dp"
        android:focusable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="5dp"
        android:button="@drawable/single_radio_chice"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"/>
    <TextView
        android:textSize="30sp"
        android:textColor="@android:color/white"
        android:id="@+id/singleitemId"
        android:focusable="false"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginLeft="20dp"
        android:layout_alignParentLeft="true"
        android:layout_centerVertical="true"/>
</com.sc.fr.onelittleangel.bouddhisme.views.CheckableRelativeLayout>
